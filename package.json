    "db:migrate": "drizzle-kit migrate",
    "db:introspect": "drizzle-kit introspect",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@better-auth/core": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.2",
    "@react-email/components": "1.0.12",
    "@sentry/nextjs": "11.6.0",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "drizzle-orm": "0.45.4",
    "framer-motion": "14.1.0",
    "jose": "6.2.12",
    "nanostores": "1.5.5",
    "next": "16.4.6",
    "pg": "8.23.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.32.1",
    "zod": "4.6.7"
