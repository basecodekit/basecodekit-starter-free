# Postgres (local dev via docker-compose on port 5434)
DATABASE_URL=postgresql://basecodekit:basecodekit@localhost:5434/basecodekit
DIRECT_URL=postgresql://basecodekit:basecodekit@localhost:5434/basecodekit

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3355

RESEND_API_KEY=
# Sender address for transactional email (magic links, etc). Must be a verified
# domain/sender in Resend for production; the resend.dev sandbox address works
# for local dev without any domain setup.
EMAIL_FROM=onboarding@resend.dev

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Observability — server-side Sentry; leave SENTRY_DSN empty to disable
SENTRY_DSN=
# Defaults to NODE_ENV; set to e.g. "staging" / "production" per deploy
SENTRY_ENVIRONMENT=
# "true" logs everything the SDK sends or drops — for troubleshooting only
SENTRY_DEBUG=

# Uploads (org logos) — Cloudflare R2. Leave any empty to turn uploads off.
# R2_ACCOUNT_ID is the 32-character id only, not the endpoint URL. The token
# needs Object Read & Write on R2_BUCKET; R2_PUBLIC_URL is the bucket's
# r2.dev or custom-domain URL. The bucket's CORS policy must allow PUT and
# GET with a Content-Type header from this app's origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
